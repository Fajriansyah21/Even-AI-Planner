rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check / connection probe
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRemoteIdTransition(prevId, nextId, prevStatus, nextStatus) {
      return (prevId == nextId)
        // Late arrival of first remote event ID (null -> non-null) in pending_cleanup:
        || (prevId == null && nextId != null && prevStatus == 'pending_cleanup' && nextStatus == 'pending_cleanup')
        // New remote event arrival after previous event was cleaned (cleaned -> pending_cleanup):
        || (prevStatus == 'cleaned' && nextStatus == 'pending_cleanup' && nextId != null && nextId != prevId);
    }

    function isValidTombstoneTransition(prevStatus, nextStatus, hasNewRemoteId) {
      return (prevStatus == 'cleaned' && nextStatus == 'cleaned' && !hasNewRemoteId)
        || (prevStatus == 'cleaned' && nextStatus == 'pending_cleanup' && hasNewRemoteId)
        || (prevStatus == 'pending_cleanup' && nextStatus in ['pending_cleanup', 'cleaning', 'cleaned', 'cleanup_failed'])
        || (prevStatus == 'cleaning' && nextStatus in ['cleaning', 'cleaned', 'cleanup_failed'] && !hasNewRemoteId)
        || (prevStatus == 'cleanup_failed' && nextStatus in ['cleanup_failed', 'cleaning', 'cleaned'] && !hasNewRemoteId);
    }

    function claimToken(data) { return data.get('cleanupClaimToken', null); }
    function leaseStartedAt(data) { return data.get('cleanupLeaseStartedAt', null); }

    function isValidClaimFenceTransition() {
      let oldToken = claimToken(existing());
      let newToken = claimToken(incoming());
      let oldLease = leaseStartedAt(existing());
      let newLease = leaseStartedAt(incoming());
      let takeover = incoming().status == 'cleaning'
        && newToken is string && newToken.size() >= 1 && newToken.size() <= 128
        && newToken != oldToken
        && newLease == request.time
        && incoming().retryCount == existing().retryCount + 1
        && (existing().status in ['pending_cleanup', 'cleanup_failed']
          || (existing().status == 'cleaning'
            && (oldLease == null || request.time >= oldLease + duration.value(7, 'm'))));
      let renewal = existing().status == 'cleaning' && incoming().status == 'cleaning'
        && newToken == oldToken && newToken is string
        && newLease == request.time
        && incoming().retryCount == existing().retryCount;
      let releaseForLateEvent = existing().status == 'cleaned'
        && incoming().status == 'pending_cleanup'
        && incoming().get('googleCalendarEventId', null) != existing().get('googleCalendarEventId', null)
        && newToken == null && newLease == null;
      let fencedResult = existing().status == 'cleaning'
        && incoming().status in ['cleaned', 'cleanup_failed']
        && oldToken is string && newToken == oldToken && newLease == oldLease;
      let noRemoteCleanup = existing().status == 'pending_cleanup'
        && incoming().status == 'cleaned'
        && existing().get('googleCalendarEventId', null) == null
        && incoming().get('googleCalendarEventId', null) == null
        && oldToken == null && newToken == null && oldLease == null && newLease == null;
      let stableState = oldToken == newToken && oldLease == newLease
        && existing().status == incoming().status
        && existing().status in ['pending_cleanup', 'cleaning', 'cleaned', 'cleanup_failed'];
      return stableState || takeover || renewal || releaseForLateEvent || fencedResult || noRemoteCleanup;
    }

    // Subcollections under /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Preferences
      match /preferences/{prefId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(prefId)
          && incoming().userId == userId
          && incoming().displayName is string && incoming().displayName.size() <= 100
          && incoming().email is string && incoming().email.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(taskId)
          && incoming().userId == userId
          && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200
          && incoming().estimatedDurationMinutes is number
          && (incoming().deadlineAt == null || incoming().deadlineAt is string)
          && incoming().priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT']
          && incoming().status in ['UNSCHEDULED', 'SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'completed_manual', 'missed_auto'];
        allow delete: if isOwner(userId);
      }

      // Calendar Events
      match /events/{eventId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(eventId)
          && incoming().userId == userId
          && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300
          && incoming().startAt is string
          && incoming().endAt is string;
        allow delete: if isOwner(userId);
      }

      // Google Keep Notes
      match /keep_notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(noteId)
          && incoming().userId == userId
          && incoming().title is string && incoming().title.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Deletion Tombstones (Authoritative cross-device monotonic deletion records)
      match /deletion_tombstones/{tombstoneId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(tombstoneId)
          && incoming().keys().hasOnly(['userId', 'taskId', 'sessionId', 'compositeKey', 'entityType', 'deletedAt', 'status', 'retryCount', 'updatedAt', 'googleCalendarEventId', 'lastAttemptAt', 'error', 'cleanupClaimToken', 'cleanupLeaseStartedAt'])
          && incoming().keys().hasAll(['userId', 'taskId', 'sessionId', 'compositeKey', 'entityType', 'deletedAt', 'status', 'retryCount', 'updatedAt'])
          && incoming().userId == userId
          && incoming().taskId is string && incoming().taskId.size() > 0 && incoming().taskId.size() <= 256
          && incoming().sessionId is string && incoming().sessionId.size() > 0 && incoming().sessionId.size() <= 256
          && incoming().compositeKey is string && incoming().compositeKey.size() > 0 && incoming().compositeKey.size() <= 512
          && incoming().entityType in ['task', 'session']
          && incoming().deletedAt is string && incoming().deletedAt.size() <= 64
          && incoming().status == 'pending_cleanup'
          && incoming().retryCount == 0
          && incoming().updatedAt is string && incoming().updatedAt.size() <= 64
          && (!('googleCalendarEventId' in incoming()) || incoming().googleCalendarEventId == null || (incoming().googleCalendarEventId is string && incoming().googleCalendarEventId.size() > 0 && incoming().googleCalendarEventId.size() <= 256))
          && (!('lastAttemptAt' in incoming()) || incoming().lastAttemptAt == null || (incoming().lastAttemptAt is string && incoming().lastAttemptAt.size() <= 64))
          && (!('error' in incoming()) || incoming().error == null || (incoming().error is string && incoming().error.size() <= 500))
          && (!('cleanupClaimToken' in incoming()) || incoming().cleanupClaimToken == null)
          && (!('cleanupLeaseStartedAt' in incoming()) || incoming().cleanupLeaseStartedAt == null);

        allow update: if isOwner(userId) && isValidId(tombstoneId)
          && incoming().keys().hasOnly(['userId', 'taskId', 'sessionId', 'compositeKey', 'entityType', 'deletedAt', 'status', 'retryCount', 'updatedAt', 'googleCalendarEventId', 'lastAttemptAt', 'error', 'cleanupClaimToken', 'cleanupLeaseStartedAt'])
          && incoming().keys().hasAll(['userId', 'taskId', 'sessionId', 'compositeKey', 'entityType', 'deletedAt', 'status', 'retryCount', 'updatedAt'])
          && incoming().userId == userId
          && incoming().taskId is string && incoming().taskId.size() > 0 && incoming().taskId.size() <= 256
          && incoming().sessionId is string && incoming().sessionId.size() > 0 && incoming().sessionId.size() <= 256
          && incoming().compositeKey is string && incoming().compositeKey.size() > 0 && incoming().compositeKey.size() <= 512
          && incoming().entityType in ['task', 'session']
          && incoming().deletedAt is string && incoming().deletedAt.size() <= 64
          && incoming().status in ['pending_cleanup', 'cleaning', 'cleaned', 'cleanup_failed']
          && incoming().retryCount is number && incoming().retryCount >= 0
          && incoming().updatedAt is string && incoming().updatedAt.size() <= 64
          && (!('googleCalendarEventId' in incoming()) || incoming().googleCalendarEventId == null || (incoming().googleCalendarEventId is string && incoming().googleCalendarEventId.size() > 0 && incoming().googleCalendarEventId.size() <= 256))
          && (!('lastAttemptAt' in incoming()) || incoming().lastAttemptAt == null || (incoming().lastAttemptAt is string && incoming().lastAttemptAt.size() <= 64))
          && (!('error' in incoming()) || incoming().error == null || (incoming().error is string && incoming().error.size() <= 500))
          && (!('cleanupClaimToken' in incoming()) || incoming().cleanupClaimToken == null || (incoming().cleanupClaimToken is string && incoming().cleanupClaimToken.size() >= 1 && incoming().cleanupClaimToken.size() <= 128))
          && (!('cleanupLeaseStartedAt' in incoming()) || incoming().cleanupLeaseStartedAt == null || incoming().cleanupLeaseStartedAt is timestamp)
          // Immutability: identity and initial deletion timestamp cannot be changed or forged
          && incoming().userId == existing().userId
          && incoming().taskId == existing().taskId
          && incoming().sessionId == existing().sessionId
          && incoming().compositeKey == existing().compositeKey
          && incoming().entityType == existing().entityType
          && incoming().deletedAt == existing().deletedAt
          // Monotonic retry count:
          && incoming().retryCount >= existing().retryCount
          // Strict remote ID lifecycle validation (no erasure, no orphan overwrite):
          && isValidRemoteIdTransition(
               existing().get('googleCalendarEventId', null),
               incoming().get('googleCalendarEventId', null),
               existing().status,
               incoming().status
             )
          // Strict status transition state machine:
          && isValidTombstoneTransition(
               existing().status,
               incoming().status,
               incoming().get('googleCalendarEventId', null) != null &&
                 incoming().get('googleCalendarEventId', null) != existing().get('googleCalendarEventId', null)
             )
          // Claim takeover/renewal uses Firestore request.time, not client clocks.
          && isValidClaimFenceTransition();

        // Tombstones are monotonic and permanent to guarantee User Deletion Intent Wins
        allow delete: if false;
      }
    }
  }
}
